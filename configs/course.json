{
  "project": "wind_solar_pumped_hydro_battery_energy_management",
  "version": "teaching-v1",
  "notice": "All equipment, costs and policy values are teaching assumptions; no real experiment results.",
  "time": {
    "step_hours": 1,
    "history_hours": 168,
    "forecast_hours": 24,
    "manager_update_hours": 6,
    "calendar_timezone": "Europe/Paris",
    "internal_timezone": "UTC",
    "telemetry": "completed previous hour available at hour start"
  },
  "data": {
    "provider": "RTE/ODRE",
    "dataset_id": "eco2mix-national-cons-def",
    "train_start": "2019-01-01",
    "train_end_exclusive": "2023-01-01",
    "validation_start": "2023-01-01",
    "validation_end_exclusive": "2024-01-01",
    "test_start": "2024-01-01",
    "test_end_exclusive": "2025-01-01",
    "scales_source": "data/processed/scales.json",
    "targets": [
      "wind_mw",
      "solar_mw",
      "load_mw"
    ],
    "availability_proxy": "historical realized generation scaled with training-only constants",
    "missing": "no interpolation in core; use complete consecutive windows"
  },
  "system": {
    "wind_capacity_mw": 80,
    "solar_capacity_mw": 60,
    "load_train_p99_target_mw": 60,
    "grid_import_max_mw": 35,
    "grid_export_max_mw": 0,
    "hydro": {
      "pump_max_mw": 20,
      "generate_max_mw": 20,
      "head_m": 200,
      "upper_active_capacity_m3": 220000,
      "transferable_total_water_m3": 220000,
      "upper_initial_water_m3": 110000,
      "pump_efficiency": 0.9,
      "generate_efficiency": 0.9,
      "rho_kg_m3": 1000,
      "g_m_s2": 9.81,
      "authoritative_state": "upper_active_water_m3",
      "simultaneous_pump_generate": false
    },
    "battery": {
      "nominal_capacity_mwh": 20,
      "charge_max_mw": 10,
      "discharge_max_mw": 10,
      "energy_min_mwh": 2,
      "energy_max_mwh": 18,
      "initial_energy_mwh": 10,
      "charge_efficiency": 0.95,
      "discharge_efficiency": 0.95,
      "simultaneous_charge_discharge": false
    }
  },
  "cost": {
    "currency": "CU (teaching cost unit)",
    "tariff_local_hours": [
      {
        "start": 0,
        "end": 6,
        "cu_per_mwh": 60
      },
      {
        "start": 6,
        "end": 17,
        "cu_per_mwh": 100
      },
      {
        "start": 17,
        "end": 21,
        "cu_per_mwh": 180
      },
      {
        "start": 21,
        "end": 24,
        "cu_per_mwh": 100
      }
    ],
    "battery_throughput_cu_per_mwh": 5,
    "curtailment_auxiliary_cu_per_mwh": 1,
    "reserve_shortfall_cu_per_mwh_hour": 2
  },
  "policies": {
    "flexible": {
      "battery_reserve_fraction": 0.3,
      "hydro_reserve_fraction": 0.3
    },
    "balanced": {
      "battery_reserve_fraction": 0.5,
      "hydro_reserve_fraction": 0.5
    },
    "reserve": {
      "battery_reserve_fraction": 0.7,
      "hydro_reserve_fraction": 0.7
    }
  },
  "control": {
    "planner": "teacher-provided shared mixed-integer MPC",
    "execute_hours": 1,
    "forecast_scenario": "median",
    "terminal_target": "episode initial battery energy and upper water",
    "terminal_horizon_shrinks_at_episode_end": true,
    "same_public_execution_recourse_for_all": true,
    "comparison_rule": "lexicographic: EENS, terminal deficit, operating cost plus common curtailment cost; exclude policy-specific reserve penalties",
    "terminal_shortfall_handling": "explicit slack in all episodes if hard recovery infeasible; retain failure labels",
    "reserve_fraction_denominators_mwh": {
      "battery": 20,
      "hydro_potential": 119.9
    },
    "real_time_recourse_assumption": "idealized hourly-average equivalent of within-hour balancing; not sub-hour feasibility verification",
    "policy_reserve_is_soft": true
  },
  "model": {
    "architecture": "teaching multivariate patch Transformer",
    "patch_hours": 6,
    "patch_stride": 6,
    "d_model": 64,
    "encoder_layers": 2,
    "attention_heads": 4,
    "ffn_dim": 128,
    "dropout": 0.1,
    "quantiles": [
      0.1,
      0.5,
      0.9
    ],
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "batch_size": 64,
    "max_epochs": 30,
    "early_stopping_patience": 5,
    "future_covariates": "known calendar only in core version"
  },
  "harness": {
    "provider": "school-provided DeepSeek V4 Flash gateway",
    "model_identifier": "record exact school gateway identifier before experiment",
    "max_model_requests_per_strategy_decision": 6,
    "max_candidate_plans_per_strategy_decision": 3,
    "max_correction_rounds": 1,
    "max_model_request_timeout_seconds": 60,
    "model_parameters": "freeze and record actual gateway-supported values",
    "log_original_and_executed_actions": true
  },
  "evaluation": {
    "episode_count": 3,
    "episode_hours": 72,
    "llm_repeats_min": 2,
    "separate_forecasting_and_management_experiments": true,
    "power_balance_tolerance_mw": 1e-06,
    "water_balance_tolerance_m3": 0.001
  }
}
